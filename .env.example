# ─────────────────────────────────────────────
# SpendSync environment variables
# Copy to .env.local for local development. Set the same keys in Vercel for production.
# ─────────────────────────────────────────────

# Clerk authentication — https://dashboard.clerk.com → API Keys (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Postgres (required). DATABASE_URL goes through the transaction pooler; DIRECT_URL is the
# session-mode / direct connection Prisma uses for migrations.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Gemini — parses inbound invoices/receipts (required for the email webhook)
GEMINI_API_KEY=

# Resend — sends renewal, leak and budget alert emails. Leave unset to log emails instead of sending.
RESEND_API_KEY=
# Verified sender, e.g. "SpendSync <alerts@yourdomain.com>". Defaults to the Resend sandbox sender.
RESEND_FROM_EMAIL=

# Shared secrets (required in production)
# Vercel Cron sends CRON_SECRET as "Authorization: Bearer <secret>" to /api/cron/*
CRON_SECRET=
# CloudMailin posts to /api/webhooks/inbound?secret=<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# 32-byte key (base64 or hex) that encrypts integration credentials at rest (strongly recommended).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical in every environment that shares the same database.
INTEGRATION_ENCRYPTION_KEY=

# Figma OAuth — https://www.figma.com/developers/apps (optional; needed for the Figma integration)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/api/auth/callback/figma

# Base CloudMailin inbound address; workspace ids are appended as +tags (optional)
CLOUDMAILIN_INBOUND_ADDRESS=

# Public URL of the app. Falls back to VERCEL_URL, then http://localhost:3000 (optional)
NEXT_PUBLIC_APP_URL=
